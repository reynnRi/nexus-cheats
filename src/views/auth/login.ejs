<section class="auth-shell">
  <div class="container auth-grid">
    <div class="auth-aside reveal">
      <p class="section-kicker">HOŞ GELDİN</p>
      <h1 class="auth-title">Tekrar <span class="neon">Giriş Yap</span></h1>
      <p class="section-lead">Panelinden üyeliğini, siparişlerini ve destek taleplerini yönet.</p>
      <ul class="feature-list feature-list-lg">
        <li>Aktif üyelik ve kalan süre bilgisi</li>
        <li>Sipariş geçmişi</li>
        <li>Profil ve şifre ayarları</li>
      </ul>
    </div>

    <div class="auth-card reveal">
      <h2 class="auth-card-title">Giriş Yap</h2>

      <% if (errors._) { %><div class="form-error form-error-top"><%= errors._ %></div><% } %>

      <form action="/giris" method="post" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="next" value="<%= next %>">

        <div class="field">
          <label for="email">E-posta</label>
          <input type="email" id="email" name="email" value="<%= form.email %>" autocomplete="email" required>
          <% if (errors.email) { %><p class="field-error"><%= errors.email %></p><% } %>
        </div>

        <div class="field">
          <label for="password">Şifre</label>
          <input type="password" id="password" name="password" autocomplete="current-password" required>
          <% if (errors.password) { %><p class="field-error"><%= errors.password %></p><% } %>
        </div>

        <button type="submit" class="btn btn-primary btn-block">Giriş Yap</button>
      </form>

      <p class="auth-switch">
        Hesabınız yok mu? <a href="/kayit">Üye olun</a>
      </p>
    </div>
  </div>
</section>
