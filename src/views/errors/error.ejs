<section class="error-shell">
  <div class="container error-inner">
    <p class="error-code"><%= status %></p>
    <h1 class="error-heading"><%= heading %></h1>
    <p class="error-message"><%= message %></p>
    <div class="error-actions">
      <a href="/" class="btn btn-primary">Ana Sayfa</a>
      <a href="/urunler" class="btn btn-outline">Ürünler</a>
      <a href="/panel/destek" class="btn btn-ghost">Destek</a>
    </div>
  </div>
</section>
