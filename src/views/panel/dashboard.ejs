<section class="page-head page-head-panel">
  <div class="container">
    <p class="section-kicker">KULLANICI PANELİ</p>
    <h1 class="page-title">Merhaba, <span class="neon"><%= currentUser.full_name.split(' ')[0] %></span></h1>
    <p class="section-lead">Üyeliğini, siparişlerini ve destek taleplerini buradan yönetebilirsin.</p>
  </div>
</section>

<div class="container panel-layout">
  <%- include('./partials/nav.ejs', { activeNav: activeNav }) %>

  <div class="panel-content">
    <div class="stat-grid">
      <article class="stat-card reveal">
        <p class="stat-label">Üyelik durumu</p>
        <p class="stat-value <%= membershipInfo.active ? 'stat-ok' : 'stat-off' %>"><%= membershipInfo.active ? 'Aktif' : 'Yok' %></p>
        <p class="stat-meta"><%= membershipInfo.planName || 'Henüz paket satın alınmadı' %></p>
      </article>

      <article class="stat-card reveal">
        <p class="stat-label">Kalan süre</p>
        <p class="stat-value">
          <% if (membershipInfo.lifetime) { %>Sınırsız<% } else if (membershipInfo.active) { %><%= membershipInfo.daysLeft %> gün<% } else { %>—<% } %>
        </p>
        <p class="stat-meta">
          <% if (membershipInfo.endsAt) { %>Bitiş: <%= helpers.formatDayTR(membershipInfo.endsAt) %><% } else if (membershipInfo.lifetime) { %>Süresiz üyelik<% } else { %>—<% } %>
        </p>
      </article>

      <article class="stat-card reveal">
        <p class="stat-label">Sipariş sayısı</p>
        <p class="stat-value"><%= helpers.formatNumber(orderList.length) %></p>
        <p class="stat-meta">Son 5 sipariş listelenir</p>
      </article>

      <article class="stat-card reveal">
        <p class="stat-label">Destek talebi</p>
        <p class="stat-value"><%= helpers.formatNumber(ticketList.length) %></p>
        <p class="stat-meta"><a href="/panel/destek">Tümünü gör</a></p>
      </article>
    </div>

    <% if (!membershipInfo.active) { %>
      <div class="notice notice-warn reveal">
        <h3>Aktif üyeliğiniz bulunmuyor</h3>
        <p>Ürünlere erişmek için bir üyelik paketi seçin. Fiyatlar: aylık 999 TL, yıllık 12.000 TL, sınırsız 33.000 TL.</p>
        <a href="/paketler" class="btn btn-primary btn-sm">Paketleri İncele</a>
      </div>
    <% } %>

    <section class="panel-section reveal">
      <header class="panel-section-head">
        <h2>Son Siparişler</h2>
        <a href="/panel/siparisler" class="link-more">Tümü</a>
      </header>

      <% if (orderList.length) { %>
        <div class="table-wrap">
          <table class="data-table">
            <thead>
              <tr><th scope="col">Sipariş No</th><th scope="col">Paket</th><th scope="col">Tutar</th><th scope="col">Durum</th><th scope="col">Tarih</th><th scope="col"></th></tr>
            </thead>
            <tbody>
              <% orderList.forEach(function (o) { %>
                <tr>
                  <th scope="row" class="mono"><%= o.order_no %></th>
                  <td><%= o.plan_name %></td>
                  <td class="price"><%= helpers.formatTL(o.amount_kurus) %></td>
                  <td><span class="status status-<%= o.status %>"><%= { pending: 'Ödeme bekliyor', paid: 'Ödendi', cancelled: 'İptal', refunded: 'İade edildi' }[o.status] || o.status %></span></td>
                  <td><%= helpers.formatDateTR(o.created_at) %></td>
                  <td><a href="/panel/siparisler/<%= o.order_no %>">Detay</a></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <p class="empty-note">Henüz siparişiniz bulunmuyor. <a href="/paketler">Paketleri inceleyin</a>.</p>
      <% } %>
    </section>

    <section class="panel-section reveal">
      <header class="panel-section-head">
        <h2>Üyelik Geçmişi</h2>
        <a href="/panel/uyelik" class="link-more">Detay</a>
      </header>

      <% if (membershipList.length) { %>
        <ul class="timeline">
          <% membershipList.slice(0, 4).forEach(function (m) { %>
            <li>
              <span class="timeline-dot" aria-hidden="true"></span>
              <div>
                <p class="timeline-title"><%= m.plan_name %> <span class="status status-<%= m.status %>"><%= { active: 'Aktif', superseded: 'Yenilendi', cancelled: 'İptal', expired: 'Süresi doldu' }[m.status] || m.status %></span></p>
                <p class="timeline-meta">
                  Başlangıç: <%= helpers.formatDayTR(m.starts_at) %> ·
                  Bitiş: <%= m.is_lifetime ? 'Süresiz' : helpers.formatDayTR(m.ends_at) %>
                </p>
              </div>
            </li>
          <% }); %>
        </ul>
      <% } else { %>
        <p class="empty-note">Henüz üyelik kaydınız yok.</p>
      <% } %>
    </section>

    <section class="panel-section reveal">
      <header class="panel-section-head">
        <h2>Destek Taleplerim</h2>
        <a href="/panel/destek" class="link-more">Yeni talep</a>
      </header>

      <% if (ticketList.length) { %>
        <ul class="ticket-list">
          <% ticketList.forEach(function (t) { %>
            <li>
              <a href="/panel/destek/<%= t.id %>">
                <span class="ticket-subject"><%= t.subject %></span>
                <span class="status status-<%= t.status %>"><%= { open: 'Açık', answered: 'Yanıtlandı', closed: 'Kapandı' }[t.status] || t.status %></span>
                <span class="ticket-date"><%= helpers.formatDayTR(t.updated_at) %></span>
              </a>
            </li>
          <% }); %>
        </ul>
      <% } else { %>
        <p class="empty-note">Açık destek talebiniz bulunmuyor.</p>
      <% } %>
    </section>
  </div>
</div>
