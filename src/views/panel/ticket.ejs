<section class="page-head page-head-panel">
  <div class="container">
    <p class="section-kicker">DESTEK TALEBİ #<%= ticket.id %></p>
    <h1 class="page-title"><%= ticket.subject %></h1>
    <p class="section-lead">
      Kategori: <%= { genel: 'Genel', odeme: 'Ödeme', uyelik: 'Üyelik', teknik: 'Teknik' }[ticket.category] || ticket.category %>
      · Durum: <span class="status status-<%= ticket.status %>"><%= { open: 'Açık', answered: 'Yanıtlandı', closed: 'Kapandı' }[ticket.status] || ticket.status %></span>
    </p>
  </div>
</section>

<div class="container panel-layout">
  <%- include('./partials/nav.ejs', { activeNav: activeNav }) %>

  <div class="panel-content">
    <div class="thread reveal">
      <% messageList.forEach(function (m) { %>
        <article class="thread-msg <%= m.is_staff ? 'thread-staff' : 'thread-user' %>">
          <header class="thread-head">
            <span class="thread-author"><%= m.is_staff ? 'NEXUS Destek' : (m.author_name || 'Siz') %></span>
            <span class="thread-date"><%= helpers.formatDateTR(m.created_at) %></span>
          </header>
          <p class="thread-body"><%= m.body %></p>
        </article>
      <% }); %>
    </div>

    <% if (ticket.status !== 'closed') { %>
      <form action="/panel/destek/<%= ticket.id %>" method="post" class="form-grid reveal">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field field-full">
          <label for="message">Yanıt yaz</label>
          <textarea id="message" name="message" rows="5" required minlength="2" maxlength="4000"></textarea>
          <% if (errors.message) { %><p class="field-error"><%= errors.message %></p><% } %>
        </div>
        <div class="field field-full">
          <button type="submit" class="btn btn-primary">Gönder</button>
          <a href="/panel/destek" class="btn btn-ghost">Taleplere Dön</a>
        </div>
      </form>
    <% } else { %>
      <div class="notice notice-info reveal">
        <h3>Bu talep kapatıldı</h3>
        <p>Yeni bir konu için yeni destek talebi oluşturabilirsiniz.</p>
        <a href="/panel/destek" class="btn btn-outline btn-sm">Yeni Talep</a>
      </div>
    <% } %>
  </div>
</div>
